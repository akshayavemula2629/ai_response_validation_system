# Application Configuration
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=127.0.0.1

# Embedding & Vector Store
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_PATH=data/processed/vector_index.faiss
METADATA_PATH=data/processed/metadata.json
TOP_K_RETRIEVAL=3
SIMILARITY_THRESHOLD=0.25

# LLM Provider (Optional - defaults to local hybrid semantic judge if empty)
# Set OPENAI_API_KEY to use OpenAI LLM-as-a-Judge
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set GEMINI_API_KEY to use Google Gemini LLM-as-a-Judge
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Scoring Weights
WEIGHT_RELEVANCE=0.25
WEIGHT_ACCURACY=0.35
WEIGHT_HALLUCINATION=0.25
WEIGHT_COMPLETENESS=0.15
